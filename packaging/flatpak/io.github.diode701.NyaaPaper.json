{
  "app-id": "io.github.diode701.NyaaPaper",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "nyaa-paper",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=ipc",
    "--device=dri",
    "--own-name=org.nyaa.Paper",
    "--talk-name=org.nyaa.Paper",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--filesystem=~/.local/share/Steam/steamapps/workshop/content/431960:ro",
    "--filesystem=~/.local/share/Steam/steamapps/common/wallpaper_engine:ro",
    "--filesystem=~/Pictures:create",
    "--filesystem=xdg-config/nyaa-paper:create"
  ],
  "modules": [
    "linux-wallpaperengine.json",
    {
      "name": "nyaa-paperd",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/nyaa-paperd/cargo",
          "PATH": "/usr/lib/sdk/rust-stable/bin:/usr/bin:/bin"
        },
        "build-args": [
          "--share=network"
        ],
        "comment": "network: cargo fetches crates (local builds; Flathub would need generated cargo sources)"
      },
      "build-commands": [
        "cargo build --release --manifest-path daemon/Cargo.toml",
        "install -Dm755 daemon/target/release/nyaa-paperd /app/bin/nyaa-paperd"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            "daemon/target",
            "gui/build",
            ".git",
            "packaging/flatpak/.flatpak-builder"
          ]
        }
      ]
    },
    {
      "name": "nyaa-paper",
      "buildsystem": "simple",
      "build-commands": [
        "cmake -S gui -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/app -DNYAA_BUILD_TESTS=OFF",
        "cmake --build build",
        "cmake --install build",
        "install -Dm755 packaging/nyaa-paper /app/bin/nyaa-paper",
        "install -Dm644 packaging/flatpak/io.github.diode701.NyaaPaper.desktop /app/share/applications/io.github.diode701.NyaaPaper.desktop",
        "install -Dm644 packaging/flatpak/io.github.diode701.NyaaPaper.metainfo.xml /app/share/metainfo/io.github.diode701.NyaaPaper.metainfo.xml",
        "install -Dm644 packaging/flatpak/io.github.diode701.NyaaPaper.png /app/share/icons/hicolor/512x512/apps/io.github.diode701.NyaaPaper.png"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            "daemon/target",
            "gui/build",
            ".git",
            "packaging/flatpak/.flatpak-builder"
          ]
        }
      ]
    }
  ]
}
