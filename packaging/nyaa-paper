#!/bin/sh
# Entry point inside the sandbox: one app, two processes.
#
# The daemon owns the wallpaper engines and must outlive the window, so when
# none is running it becomes the sandbox's main process (exec) and the GUI is
# started next to it. Flatpak keeps a sandbox alive as long as its main process
# runs: closing the window (q) leaves the daemon and the wallpapers running.
# A later launch finds the daemon on the bus and only opens the window.
set -e

export NYAA_GUI="${NYAA_GUI:-/app/bin/nyaa-paper-qt}"
export NYAA_ENGINE="${NYAA_ENGINE:-/app/bin/linux-wallpaperengine}"

daemon_running() {
    # busctl is not in the runtime; gdbus is
    gdbus call --session --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner org.nyaa.Paper 2>/dev/null \
        | grep -q true
}

if daemon_running; then
    exec "$NYAA_GUI" "$@"
fi

# the GUI reads library/engine state once at startup, so open it only after
# the daemon owns its name (it scans the workshop first; give it 5 s)
(
    for _ in $(seq 50); do
        daemon_running && break
        sleep 0.1
    done
    exec "$NYAA_GUI" "$@"
) &
exec /app/bin/nyaa-paperd
